# Copy to .env.server.local (ignored by Git). SERVER ONLY. Never prefix secrets with VITE_.
SUPABASE_URL=
# Supabase secret key sb_secret_... or legacy service_role. NOT the public/anon key.
SUPABASE_SECRET_KEY=
PUBLIC_APP_ORIGIN=http://127.0.0.1:5173
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Only verified reverse-proxy CIDRs; blank is safe but shares IP limits behind a proxy.
TRUST_PROXY_CIDRS=
